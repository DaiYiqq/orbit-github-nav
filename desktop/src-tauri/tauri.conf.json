{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "mainBinaryName": "Orbit",
  "version": "1.0.0",
  "identifier": "cn.orbit.githubnav",
  "build": {
    "frontendDist": "../../site",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "npm run dev:site"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orbit · GitHub 导航站",
        "width": 1360,
        "height": 900,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "shortDescription": "发现值得用的开源项目",
    "longDescription": "Orbit 自动收录 GitHub 优质仓库，按分类与星标整理，集成 AI 导航、AI 社区、博客与论文，支持搜索、筛选、收藏、分享与跨端同步。",
    "category": "DeveloperTool",
    "copyright": "Orbit · GitHub 导航站",
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
